generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Pessoa {
  id       Int        @id @default(autoincrement())
  name     String
  email    String     @unique
  password String
  tipo     TipoPessoa

  motorista     Motorista?
  administrador Administrador?
  responsavel   Responsavel?
  aluno Aluno?
}

model Aluno {
  id Int @id @default(autoincrement())
  matricula String @unique

  pessoa_id Int @unique
  pessoa Pessoa @relation(fields: [pessoa_id], references: [id])

  cidade_id Int 
  cidade Cidade @relation(fields: [cidade_id], references: [id])
}


model Motorista {
  id            Int     @id @default(autoincrement())
  identificacao String  @unique
  telefone      String?
  pessoa_id     Int     @unique
  pessoa        Pessoa  @relation(fields: [pessoa_id], references: [id])
}

model Administrador {
  id        Int @id @default(autoincrement())
  pessoa_id Int @unique

  pessoa Pessoa @relation(fields: [pessoa_id], references: [id])
}

model Responsavel {
  id        Int     @id @default(autoincrement())
  telefone  String?
  pessoa_id Int     @unique

  pessoa Pessoa @relation(fields: [pessoa_id], references: [id])
}

enum TipoPessoa {
  ADMINISTRADOR
  MOTORISTA
  ALUNO
  RESPONSAVEL
}

model Cidade {
  id Int @id @default(autoincrement())
  nome String
  uf String
  alunos Aluno[]

  @@unique([nome,uf])
}
